<Project Sdk="Microsoft.NET.Sdk">

  <!-- 決まりの層（PartsLife.Core）の試験。WPF を持たないので Linux でも回る:
         dotnet test tests/PartsLife.Core.Tests -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PartsLife.Core\PartsLife.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 本物の本文で試す。作り物の本文で通っても、配る物が通る保証にはならない -->
    <None Include="..\..\assets\story.json" Link="assets\story.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\adventure.json" Link="assets\adventure.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
