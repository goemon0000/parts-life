<Window x:Class="PartsLife.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="clr-namespace:PartsLife.Rendering"
        Title="Parts Party"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="NearestNeighbor">

  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#E6101319" />
    <SolidColorBrush x:Key="PanelEdge" Color="#4C5DD8BB" />
    <SolidColorBrush x:Key="Text" Color="#DDE5F8" />
    <SolidColorBrush x:Key="Sub" Color="#9AA7C4" />
    <SolidColorBrush x:Key="Accent" Color="#5DD8BB" />

    <!-- 小さな四角いボタン。枠の中に文字だけ。 -->
    <Style x:Key="TinyButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#9AA7C4" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#33FFFFFF" />
                <Setter Property="Foreground" Value="#DDE5F8" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 窓の上のタブ。押すと下に設定の欄が開き、もう一度押すと畳む。
         RadioButton にしてあるのは、読み上げで「n 個中 m 番目のタブ」として扱われるため -->
    <Style x:Key="TabButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#9AA7C4" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="9,2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#22FFFFFF" />
                <Setter Property="Foreground" Value="#DDE5F8" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#5DD8BB" />
                <Setter Property="Foreground" Value="#DDE5F8" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="Background" Value="#335DD8BB" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 設定の欄の選択肢（CheckBox / RadioButton どちらにも使う）。○ / ● で選ばれているかを示す -->
    <Style x:Key="OptionToggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="#DDE5F8" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Margin" Value="0,0,6,2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="3" Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="g" Text="○" Foreground="#9AA7C4" Margin="0,0,5,0" VerticalAlignment="Center" />
                <ContentPresenter VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="g" Property="Text" Value="●" />
                <Setter TargetName="g" Property="Foreground" Value="#5DD8BB" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#22FFFFFF" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#8C5DD8BB" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 設定の欄の押しボタン（今すぐ確認・点検を開く・最初から など）。枠を付けて選択肢と見分ける -->
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Foreground" Value="#DDE5F8" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,0,6,2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" BorderBrush="#4C5DD8BB" BorderThickness="1"
                    CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#33FFFFFF" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#5DD8BB" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 右下の掴み。窓に枠が無いので、掴める場所を自前で置く。 -->
    <Style x:Key="GripStyle" TargetType="Thumb">
      <Setter Property="Cursor" Value="SizeNWSE" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Grid Background="Transparent">
              <Path Data="M 11,1 L 11,11 L 1,11 Z" Fill="#8C5DD8BB" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="Shell">
    <StackPanel x:Name="Root">

      <!-- 上の上: タブ。右クリックの献立と同じ物を、見える所に並べる（中身は MainWindow.Tabs.cs）。
           「ようす」が選ばれている間は設定の欄を畳み、いつもの盤だけの姿 -->
      <Border x:Name="TabBar" Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelEdge}"
              BorderThickness="1" CornerRadius="6" Padding="3,1" Margin="0,0,0,3">
        <StackPanel x:Name="TabStrip" Orientation="Horizontal"
                    KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle" />
      </Border>

      <!-- タブを選んだときだけ開く設定の欄 -->
      <Border x:Name="SettingsPanel" Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelEdge}"
              BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,0,0,3" Visibility="Collapsed">
        <StackPanel x:Name="SettingsStack" KeyboardNavigation.TabNavigation="Cycle" />
      </Border>

      <!-- 上: 物語。文字は拡大しない。常に読みやすい大きさで置く -->
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelEdge}"
              BorderThickness="1" CornerRadius="6" Padding="9,6" x:Name="StoryPanel">
        <StackPanel>
          <!-- 章題と、いま居る所。**ボタンを先に置く**（DockPanel は先の子から幅を取る）。
               章題を先に置くと、長い章題と行き先の名前でボタンが枠の外へ押し出されうる。
               幅が足りなければ、まず居る所が、それでも足りなければ章題が「…」で切れる -->
          <DockPanel LastChildFill="True">
            <Button x:Name="CloseButton" Style="{StaticResource TinyButton}" Content="✕"
                    DockPanel.Dock="Right" />
            <Button x:Name="SizeButton" Style="{StaticResource TinyButton}" Content="⤢"
                    DockPanel.Dock="Right" />
            <Button x:Name="TopmostButton" Style="{StaticResource TinyButton}" Content="📌"
                    DockPanel.Dock="Right" />
            <Button x:Name="LangButton" Style="{StaticResource TinyButton}" Content="EN"
                    DockPanel.Dock="Right" />
            <TextBlock x:Name="ChapterText" Foreground="{StaticResource Accent}"
                       FontSize="10" FontWeight="SemiBold" Text="" DockPanel.Dock="Left"
                       VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="PlaceText" Foreground="{StaticResource Accent}"
                       FontSize="10" FontWeight="SemiBold" Text="" VerticalAlignment="Center"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <TextBlock x:Name="StoryLine1" Foreground="{StaticResource Text}" FontSize="12"
                     Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="" />
          <TextBlock x:Name="StoryLine2" Foreground="{StaticResource Sub}" FontSize="12"
                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="" />
          <!-- 更新のお知らせ（「v0.7.3 に更新しました」「新しい版 v0.7.3 があります」）。普段は畳んである。
               リンクは Release のページを既定のブラウザで開くだけ（アプリ自身は通信しない） -->
          <DockPanel x:Name="NoticeBar" LastChildFill="True" Margin="0,4,0,0" Visibility="Collapsed">
            <Button x:Name="NoticeClose" Style="{StaticResource TinyButton}" Content="✕" FontSize="9"
                    DockPanel.Dock="Right" />
            <Button x:Name="NoticeLink" Style="{StaticResource TinyButton}" Foreground="{StaticResource Accent}"
                    DockPanel.Dock="Right" Visibility="Collapsed" />
            <TextBlock x:Name="NoticeText" Foreground="{StaticResource Accent}" FontSize="11"
                       VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- 中: 基板。等倍で描いた絵を拡大して置く。レベルの字だけは絵の上に重ねる
           （絵と一緒に拡大すると、ドットの字が読めなくなるため） -->
      <Grid x:Name="BoardHost" HorizontalAlignment="Center">
        <rendering:BoardSurface x:Name="BoardImage" />
        <Canvas x:Name="LevelLayer" IsHitTestVisible="False" />
      </Grid>

      <!-- 下: 開閉 -->
      <Border Background="#BF101319" CornerRadius="0,0,6,6" x:Name="ArrowBar">
        <Button x:Name="ExpandButton" Style="{StaticResource TinyButton}" Content="▼"
                HorizontalAlignment="Stretch" FontSize="10" />
      </Border>

      <!-- 展開: 数値。畳んでいる間は数字を見せない -->
      <Border x:Name="DetailPanel" Background="{StaticResource Panel}"
              BorderBrush="{StaticResource PanelEdge}" BorderThickness="1"
              CornerRadius="6" Padding="9,7" Margin="0,3,0,0" Visibility="Collapsed">
        <StackPanel x:Name="DetailStack" />
      </Border>

    </StackPanel>

    <Thumb x:Name="Grip" Style="{StaticResource GripStyle}" Width="14" Height="14"
           HorizontalAlignment="Right" VerticalAlignment="Bottom" />
  </Grid>
</Window>
