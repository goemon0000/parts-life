<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 8 のサポートは 2026-11 で切れる。新規配布物は 10(LTS) に合わせる。 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PartsLife</AssemblyName>
    <RootNamespace>PartsLife</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe のアイコン。tools/make-icon.py でアトラスから焼き直せる -->
    <ApplicationIcon>..\..\assets\PartsLife.ico</ApplicationIcon>
    <!-- Linux 上でも WPF をビルドできるようにする（開発側が Linux のため） -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- exe の属性。**署名を受けるには中身の名乗りが要る**（SignPath の条件）。
         署名の有無に関わらず、右クリック→プロパティで何のファイルか分かる方が良い。 -->
    <Version>0.3.1</Version>
    <Product>パーツぐらし / Parts Life</Product>
    <AssemblyTitle>パーツぐらし</AssemblyTitle>
    <Description>PCパーツのキャラクターが実機の稼働状況を姿で表す常駐アプリ</Description>
    <Company>web-autoai.com</Company>
    <Copyright>Copyright (c) 2026 web-autoai.com</Copyright>
  </PropertyGroup>

  <!-- 配布用: 何も入っていない Windows でも動く単一 exe -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 絵は exe に埋め込む。外部ファイルにすると配布で欠ける -->
    <Resource Include="..\..\assets\characters.png" Link="Assets\characters.png" />
    <Resource Include="..\..\assets\marks.png" Link="Assets\marks.png" />
    <Resource Include="..\..\assets\atlas.json" Link="Assets\atlas.json" />
    <!-- 物語の本文。ここを書き換えるだけで場面を足せる（C# は触らない） -->
    <Resource Include="..\..\assets\story.json" Link="Assets\story.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- SSD/HDD の判別に MSFT_PhysicalDisk を引くため -->
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

</Project>
