<Project Sdk="Microsoft.NET.Sdk">

  <!--
    物語・レベル・冒険の「決まり」だけを持つ層。**WPF を一切参照しない。**
    画面の無い機械（Linux の CI）でも、この層だけは試験を回せるようにするため。
    実測（Sensors）と描画（Rendering）はアプリ側に残す。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PartsLife.Core</AssemblyName>
    <RootNamespace>PartsLife</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- 配布物（単一 exe）の横に .pdb を残さない。アプリ側と揃える -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- GPU の別名の決まり。点検（PartsLife.Checks）と同じソースを取り込む -->
    <Compile Include="..\Shared\GpuAliasRule.cs" Link="Shared\GpuAliasRule.cs" />
  </ItemGroup>

</Project>
